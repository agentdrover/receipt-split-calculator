root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Правила для ktlint. Стиль задан явно: без ktlint_code_style набор правил
# зависит от версии движка.
[*.{kt,kts}]
max_line_length = 120
ktlint_code_style = ktlint_official
# Compose-функции называются с заглавной буквы, это не нарушение.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Имена тестов в обратных кавычках: предложения, длина не ограничена.
ktlint_ignore_back_ticked_identifier = true

[*.{yml,yaml,json,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
